# Copia este archivo como ".env" para desarrollo local (y usa las variables
# equivalentes en el panel de Vercel para producción).

# Cadena de conexión de Postgres (Neon).
# Al conectar la integración de Neon a tu proyecto en Vercel, esta variable
# (DATABASE_URL) se inyecta automáticamente — no necesitas copiarla a mano allí.
# Para desarrollo local, pégala desde el panel de Neon.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/db?sslmode=require"

# Secreto para firmar las sesiones (cookies). Pon una cadena larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
