# Copia este archivo como ".env" para desarrollo local (y usa las variables
# equivalentes en el panel de Vercel para producción).

# Cadena de conexión de Postgres (Neon).
# Al conectar la integración de Neon a tu proyecto en Vercel, esta variable
# (DATABASE_URL) se inyecta automáticamente — no necesitas copiarla a mano allí.
# Para desarrollo local, pégala desde el panel de Neon.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/db?sslmode=require"

# Secreto para firmar las sesiones (cookies). Pon una cadena larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- Login con Google (OAuth) ---
# Créalas en https://console.cloud.google.com  → APIs y servicios → Credenciales
# → Crear credenciales → ID de cliente de OAuth → Aplicación web.
# Redirect URI autorizada:  https://TU-DOMINIO.vercel.app/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Login con Facebook (OAuth) ---
# Créalas en https://developers.facebook.com  → Crear app → Inicio de sesión con Facebook.
# Redirect URI (OAuth) válida:  https://TU-DOMINIO.vercel.app/api/oauth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Importar comentarios de YouTube ---
# API key de la YouTube Data API v3.
# En https://console.cloud.google.com → APIs y servicios → Biblioteca →
# activa "YouTube Data API v3" → Credenciales → Crear credenciales → Clave de API.
YOUTUBE_API_KEY=""
